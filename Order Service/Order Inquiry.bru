meta {
  name: Order Inquiry
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/webopenplatformapi/api/order/getOrders
  auth: none
}

vars:pre-request {
  @description('Customer order number')
  txlogisticId: 
}

script:pre-request {
  const CryptoJS = require('crypto-js');

  const apiAccount   = bru.getEnvVar('apiAccount');
  const privateKey   = bru.getEnvVar('privateKey');
  const customerCode = bru.getEnvVar('customerCode');
  const password     = bru.getEnvVar('password');
  const txlogisticId = bru.getRequestVar('txlogisticId') || bru.getProcessEnv('txlogisticId');

  const timestamp = Date.now().toString();

  // Service signature carried inside bizContent
  const pws = CryptoJS.MD5(password + 'jadada236t2').toString().toUpperCase();
  const bizDigest = CryptoJS.enc.Base64.stringify(CryptoJS.MD5(customerCode + pws + privateKey));
  const bizContent = JSON.stringify({ customerCode, digest: bizDigest, txlogisticId });

  // Header signature is computed over the final bizContent string
  const headerDigest = CryptoJS.enc.Base64.stringify(CryptoJS.MD5(bizContent + privateKey));

  req.setHeader('apiAccount', apiAccount);
  req.setHeader('digest', headerDigest);
  req.setHeader('timestamp', timestamp);
  req.setHeader('Content-Type', 'application/x-www-form-urlencoded');
  req.setBody('bizContent=' + encodeURIComponent(bizContent));
}

tests {
  test('returns HTTP 200', function () {
    expect(res.status).to.equal(200);
  });

  test('J&T code is 1 (success)', function () {
    if (String(res.body.code) !== '1') {
      console.log('J&T response:', JSON.stringify(res.body));
    }
    expect(String(res.body.code)).to.equal('1');
  });
}
